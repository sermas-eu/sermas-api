# nestjs-asyncapi 1.3 declares NestJS <=10 / swagger <=7 as peers. It works on NestJS 11
# with @nestjs/swagger 11.4.2 (the last release without an exports map), and 2.x emits
# AsyncAPI 3 documents, a contract change. Remove this once that is settled.
legacy-peer-deps=true
# With legacy-peer-deps npm does not install peers. Required peers the production tree
# needs are therefore direct dependencies: @babel/core (asyncapi generator, loaded at
# boot), keyv (@nestjs/cache-manager).
