{
  "name": "@sermas/api",
  "version": "1.0.84",
  "private": true,
  "description": "SERMAS Toolkit API",
  "author": "SpindoxLabs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sermas-eu/sermas-api.git"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "NODE_ENV=production node dist/apps/api/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch --silent=false --runInBand --colors --verbose=true",
    "test:cov": "NODE_ENV=test jest --coverage --silent=false",
    "test:debug": "LOG_LEVEL=debug DEBUG=jest NODE_ENV=test node --inspect=0.0.0.0:9229 -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --watchAll --silent=false --verbose=true --useStderr=true"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.5.0",
    "@google-cloud/text-to-speech": "^5.2.0",
    "@keycloak/keycloak-admin-client": "^24.0.3",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.2",
    "@stoplight/json": "3.21.0",
    "@turf/turf": "^6.5.0",
    "axios": "^1.6.8",
    "cache-manager": "^7.2.9",
    "chromadb": "^1.8.1",
    "chromadb-default-embed": "^2.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eta": "^3.5.0",
    "fast-fuzzy": "^1.12.0",
    "flatten-svg": "^0.3.0",
    "form-data": "^4.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "keyv": "^5.6.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "minio": "^7.1.3",
    "mongoose": "^8.3.2",
    "mqtt": "^5.5.2",
    "nestjs-asyncapi": "1.3.0",
    "nestjs-minio-client": "^2.2.0",
    "openai": "^4.89.0",
    "openapi-client-axios": "^7.5.4",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.3",
    "sox-stream": "^2.0.6",
    "ssml-check-core": "^0.3.9",
    "string-similarity": "^4.0.4",
    "svgdom": "^0.1.19",
    "typedarray-to-buffer": "^4.0.0",
    "ulidx": "^2.3.0",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.0.0",
    "@types/node-wav": "^0.0.3",
    "@types/socket.io-client": "^3.0.0",
    "@types/string-similarity": "^4.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "ts-jest": "29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^libs/(.*)$": "<rootDir>/libs/$1",
      "^apps/(.*)$": "<rootDir>/apps/$1"
    }
  }
}
