{
  "name": "@sermas/api",
  "version": "1.0.84",
  "private": true,
  "description": "SERMAS Toolkit API",
  "author": "SpindoxLabs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sermas-eu/sermas-api.git"
  },
  "type": "module",
  "imports": {
    "#apps/*": {
      "source": "./apps/*.ts",
      "default": "./dist/apps/*.js"
    },
    "#libs/*": {
      "source": "./libs/*.ts",
      "default": "./dist/libs/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "start:dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/apps/api/src/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:int": "NODE_ENV=test SERMAS_TEST=int vitest run"
  },
  "dependencies": {
    "@google-cloud/speech": "^6.5.0",
    "@google-cloud/text-to-speech": "^5.2.0",
    "@keycloak/keycloak-admin-client": "^24.0.3",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^12.0.5",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.2",
    "@stoplight/json": "3.21.0",
    "@turf/turf": "^6.5.0",
    "axios": "^1.6.8",
    "cache-manager": "^7.2.9",
    "chromadb": "^3.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eta": "^3.5.0",
    "fast-fuzzy": "^1.12.0",
    "flatten-svg": "^0.3.0",
    "form-data": "^4.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwt-decode": "^4.0.0",
    "keyv": "^5.6.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "minio": "^8.0.7",
    "mongoose": "^9.12.2",
    "mqtt": "^5.5.2",
    "openai": "^4.89.0",
    "openapi-client-axios": "^7.5.4",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.3",
    "sox-stream": "^2.0.6",
    "ssml-check-core": "^0.3.9",
    "string-similarity": "^4.0.4",
    "svgdom": "^0.1.19",
    "ulidx": "^2.3.0",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.21",
    "@types/form-data": "^2.5.0",
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.0.0",
    "@types/node-wav": "^0.0.3",
    "@types/socket.io-client": "^3.0.0",
    "@types/string-similarity": "^4.0.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
